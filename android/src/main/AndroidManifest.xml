<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Autoupdate sin Play Store: instalar un APK descargado requiere este
         permiso normal (API 26+) — dispara el diálogo "instalar apps
         desconocidas" del sistema la primera vez, no instala nada en frío. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="ACP Terminal"
        android:allowBackup="false"
        android:theme="@style/Theme.AcpSsh">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Expone el APK descargado (en cacheDir) al instalador del sistema
             sin exportar todo el cacheDir ni usar un content:// de terceros. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
